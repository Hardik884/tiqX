# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma separated list of allowed origins, or * to allow any origin.
CORS_ORIGIN=*

# Grace period for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Single source of truth for the connection; used by the API pool and by the
# migration runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tiqx

# Set to true when the database requires TLS (most managed providers do).
DATABASE_SSL=false

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. The process refuses to start without it. Generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is deliberately rejected by config validation, so an
# unedited copy of this file fails fast instead of signing tokens with a value
# that is public in the repository.
JWT_SECRET=replace-this-with-a-long-random-value-min-32-chars

JWT_ISSUER=tiqx-api
JWT_AUDIENCE=tiqx-client

# Access tokens are not revocable, so keep the window small (60-3600s).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are revocable server-side, so they may live much longer.
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REQUIRED. Redis backs distributed rate limiting; the auth endpoints fail
# closed without it, so the process refuses to start with no URL configured.
REDIS_URL=redis://localhost:6379

# Prefixes every key. Give two deployments sharing one Redis distinct values.
REDIS_NAMESPACE=tiqx
REDIS_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Trust X-Forwarded-For when resolving the client IP. Enable ONLY behind a
# proxy that overwrites the header - otherwise clients can spoof their own IP
# and bypass IP-keyed limits.
TRUST_PROXY=false

# login: keyed on (email, ip) - targets credential stuffing against one account
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# register: keyed on ip - targets mass account creation
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# refresh: keyed on ip - bounded cardinality, unlike keying on a presented token
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
# ticket verify: keyed on the authenticated user - the door-scanning role is
# granted per user, not per IP
RATE_LIMIT_TICKET_VERIFY_MAX=120
RATE_LIMIT_TICKET_VERIFY_WINDOW_SECONDS=60
# search: keyed on ip - the one public, unauthenticated, filter/full-text read
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
