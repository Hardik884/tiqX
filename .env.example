# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Runs the hold-expiration/ticket-email, waitlist-allocation and real-time
# seat-status worker loops inside this same process instead of as separate
# `npm run worker` / `worker:waitlist` / `worker:realtime` processes. Off by
# default - a deployment that already runs those as their own processes must
# NOT also set this, or both would claim the same outbox rows. Meant for a
# single-process deployment target (e.g. one free-tier web service) where the
# alternative is the workers never running at all.
RUN_IN_PROCESS_WORKERS=false

# Comma separated list of allowed origins, or * to allow any origin.
CORS_ORIGIN=*

# Grace period for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Single source of truth for the connection; used by the API pool and by the
# migration runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tiqx

# Set to true when the database requires TLS (most managed providers do).
DATABASE_SSL=false

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED. The process refuses to start without it. Generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The placeholder below is deliberately rejected by config validation, so an
# unedited copy of this file fails fast instead of signing tokens with a value
# that is public in the repository.
JWT_SECRET=replace-this-with-a-long-random-value-min-32-chars

JWT_ISSUER=tiqx-api
JWT_AUDIENCE=tiqx-client

# Access tokens are not revocable, so keep the window small (60-3600s).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens are revocable server-side, so they may live much longer.
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REQUIRED. Redis backs distributed rate limiting; the auth endpoints fail
# closed without it, so the process refuses to start with no URL configured.
REDIS_URL=redis://localhost:6379

# Prefixes every key. Give two deployments sharing one Redis distinct values.
REDIS_NAMESPACE=tiqx
REDIS_CONNECT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Trust X-Forwarded-For when resolving the client IP. Enable ONLY behind a
# proxy that overwrites the header - otherwise clients can spoof their own IP
# and bypass IP-keyed limits.
TRUST_PROXY=false

# login: keyed on (email, ip) - targets credential stuffing against one account
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
# register: keyed on ip - targets mass account creation
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# refresh: keyed on ip - bounded cardinality, unlike keying on a presented token
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=300
# ticket verify: keyed on the authenticated user - the door-scanning role is
# granted per user, not per IP
RATE_LIMIT_TICKET_VERIFY_MAX=120
RATE_LIMIT_TICKET_VERIFY_WINDOW_SECONDS=60
# search: keyed on ip - the one public, unauthenticated, filter/full-text read
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Ticket email
# ---------------------------------------------------------------------------
# 'mock' (default) logs the message and records it in memory - no API key
# needed, safe for development and tests. 'resend' and 'brevo' send for real.
EMAIL_PROVIDER=mock

# REQUIRED when EMAIL_PROVIDER=resend. Get one at https://resend.com - never
# commit a real value here.
RESEND_API_KEY=
# REQUIRED when EMAIL_PROVIDER=brevo. Get one at https://www.brevo.com under
# SMTP & API -> API Keys - never commit a real value here.
BREVO_API_KEY=
# REQUIRED for whichever provider is selected. Must be a verified sender on
# that provider's account (Resend: a verified domain; Brevo: a verified
# single sender address).
EMAIL_FROM=tickets@example.com

# Claiming ticket_email_outbox rows: FOR UPDATE SKIP LOCKED, mark processed,
# or back off and retry. Runs inside the hold-expiration worker process
# (`npm run worker`), not a separate one.
NOTIFICATIONS_OUTBOX_POLL_INTERVAL_MS=2000
NOTIFICATIONS_OUTBOX_BATCH_SIZE=50
NOTIFICATIONS_OUTBOX_RETRY_BASE_MS=2000
NOTIFICATIONS_OUTBOX_RETRY_MAX_MS=300000

# ---------------------------------------------------------------------------
# Hold expiration worker (`npm run worker`)
# ---------------------------------------------------------------------------
# Publishing the Redis expiry signal for newly created holds, from
# hold_expiration_outbox.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Backoff base for a failed publish: delay is base * 2^(attempts-1), capped.
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000

# Sweeping holds whose time is up. This is the authoritative path - it reads
# PostgreSQL, never Redis.
EXPIRY_SWEEP_INTERVAL_MS=1000
EXPIRY_SWEEP_BATCH_SIZE=100

# Restoring Redis expiry keys lost after their outbox row was already
# processed (eviction, flush, restart without persistence).
RECONCILE_INTERVAL_MS=30000
RECONCILE_BATCH_SIZE=200
RECONCILE_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Waitlist allocation worker (`npm run worker:waitlist`)
# ---------------------------------------------------------------------------
# How long a waitlist offer holds its seat before it lapses to the next
# candidate (60-3600s).
WAITLIST_OFFER_TTL_SECONDS=300

# Claiming waitlist_allocation_outbox rows (one row per event+category with a
# pending "seats may be available" signal).
WAITLIST_ALLOCATION_POLL_INTERVAL_MS=1000
WAITLIST_ALLOCATION_BATCH_SIZE=50
WAITLIST_ALLOCATION_RETRY_BASE_MS=1000
WAITLIST_ALLOCATION_RETRY_MAX_MS=60000

# Self-healing scan for event/categories with a waiting candidate and an
# available seat but no pending outbox row.
WAITLIST_RECONCILE_INTERVAL_MS=30000
WAITLIST_RECONCILE_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Real-time seat status / WebSocket (`npm run worker:realtime`)
# ---------------------------------------------------------------------------
# Claiming seat_status_outbox rows and publishing them to Redis Pub/Sub, which
# the API process's WebSocket server (mounted at /ws) fans out to subscribers.
REALTIME_OUTBOX_POLL_INTERVAL_MS=200
REALTIME_OUTBOX_BATCH_SIZE=200
REALTIME_OUTBOX_RETRY_BASE_MS=1000
REALTIME_OUTBOX_RETRY_MAX_MS=60000

# How often the WebSocket layer pings each open connection, and how long a
# connection has to pong back before it is terminated as dead.
REALTIME_HEARTBEAT_INTERVAL_MS=30000
REALTIME_HEARTBEAT_TIMEOUT_MS=10000

# Caps on one connection's cost to the process, regardless of what a client
# asks for.
REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=50
REALTIME_MAX_MESSAGE_BYTES=4096
# A connection whose outgoing buffer grows past this many bytes is treated as
# too slow to keep up with; further sends to it are dropped, not queued.
REALTIME_MAX_BUFFERED_BYTES=1048576
