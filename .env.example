# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma separated list of allowed origins, or * to allow any origin.
CORS_ORIGIN=*

# Grace period for in-flight requests during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Single source of truth for the connection; used by the API pool and by the
# migration runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tiqx

# Set to true when the database requires TLS (most managed providers do).
DATABASE_SSL=false

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
